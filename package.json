{
  "name": "fuzzily-mongoose",
  "version": "1.2.7",
  "author": "Manish Prasad <manishvaishu25@gmail.com>",
  "description": "Mongoose fuzzy searching plugin",
  "main": "index.js",
  "scripts": {
    "lint:fix": "eslint --fix .",
    "format": "prettier --write \"./**/*.{json,js}\"",
    "lint": "eslint \"./**/*.js\"",
    "test:integration": "jest --colors --runInBand __tests__/**.test.js",
    "test:unit": "jest --colors spec.js",
    "test": "jest --colors --runInBand",
    "test:watch": "npm test -- --watch",
    "test:unit:watch": "npm run test:unit --watch",
    "test:integration:watch": "npm run test:integration --watch",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "keywords": [
    "mongoose",
    "fuzzy",
    "searching",
    "search",
    "plugin",
    "mongo",
    "mongodb"
  ],
  "bugs": {
    "url": "https://github.com/manisuec/fuzzily-mongoose/issues"
  },
  "homepage": "https://github.com/manisuec/fuzzily-mongoose",
  "license": "MIT",
  "peerDependencies": {
    "mongoose": "^8.1.2"
  },
  "engines": {
    "node": ">=20.17"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "mongodb-memory-server": "^10.4.3",
    "mongoose": "^8.1.2",
    "prettier": "^3.8.3"
  }
}
